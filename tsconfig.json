{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "contracts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // Scripts run directly with Node's type stripping, which only accepts syntax that erases to JavaScript.
    "erasableSyntaxOnly": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
