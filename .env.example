# Cosmos Pay testnet key (starts with dv_). Never commit the real value.
COSMOS_PAY_API_KEY=dv_REPLACE_WITH_YOUR_TESTNET_KEY

# Public Stellar testnet account that receives test payments (starts with G...)
COSMOS_PAY_DESTINATION=G_REPLACE_WITH_YOUR_TESTNET_ACCOUNT

# Optional: long random token that enables POST /api/products (Authorization: Bearer <token>).
# Leave empty to disable direct product minting.
ADMIN_API_TOKEN=

# Optional: origin allowed to call the API from another domain (e.g. https://mi-frontend.com).
# Leave empty when the frontend is served by this same server.
CORS_ORIGIN=

# Optional: where products, batches and purchases are stored. Defaults to data/verifire-state.json.
DATA_FILE=

# Two separate Stellar accounts, so a customer reading a certificate never reaches the company's finances:
#   Treasury (COSMOS_PAY_DESTINATION above): receives the Cosmos Pay payments for each batch. Never signs on-chain.
#   Issuer (STELLAR_ISSUER_SECRET below): registers products, certifies warranties and pays their network fees.
#     It holds only the small balance needed for those fees; top it up from the treasury off-band.
# `node scripts/deploy-contract.mjs` fills these three in .env.
# While STELLAR_CONTRACT_ID is empty, warranties are stored only locally (demo mode).
STELLAR_NETWORK=
STELLAR_CONTRACT_ID=
# Secret key of the issuing account. Server only, never commit. (Old name: STELLAR_ADMIN_SECRET.)
STELLAR_ISSUER_SECRET=
# Optional: Soroban RPC endpoint (defaults to the public testnet RPC).
STELLAR_RPC_URL=

# Test amount per token.
COSMOS_PAY_AMOUNT=100
PORT=5501
