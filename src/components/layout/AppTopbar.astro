---
import BrandLogo from './BrandLogo.astro';

interface Props {
  brandHref?: string;
}

const { brandHref } = Astro.props;
---

<header class="topbar">
  <div class="container nav catalog-nav">
    <BrandLogo href={brandHref} />
    <div class="user-actions">
      <slot />
    </div>
  </div>
</header>
