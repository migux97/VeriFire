---
// The Verifire logo: black letters on light backgrounds, white (`light`) on the black footer. Styles in brand.css.
interface Props {
  href?: string | undefined;
  light?: boolean;
}

const { href = '/', light = false } = Astro.props;
---

<a class="lp-logo" href={href} aria-label="Verifire, inicio">
  <img src={light ? '/brand/verifire-light.png' : '/brand/verifire.png'} alt="" width="516" height="160" />
</a>
