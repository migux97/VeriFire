---
import { getLandingMessages } from '@/i18n/landing';
import { getLandingContent } from '@/i18n/landing-content';
import { getTechnicalLandingCopy } from '@/i18n/technical-landing';
import { AuditWidget } from './AuditWidget';
const locale = Astro.currentLocale ?? 'es';
const { hero, audit } = getTechnicalLandingCopy(locale);
const { artwork } = getLandingMessages(locale);
const { sampleProducts } = getLandingContent(locale);
const product = sampleProducts.find((product) => product.id === 'auriculares')!;
---
<section class="lp-hero lp-technical-hero" aria-labelledby="lp-hero-title">
  <div class="lp-hero-copy">
    <p class="lp-eyebrow"><span class="lp-eyebrow-dot lp-pulse" aria-hidden="true"></span>{hero.eyebrow}</p>
    <h1 id="lp-hero-title">{hero.title}</h1>
    <p class="lp-hero-lead">{hero.lead}</p>
    <div class="lp-hero-actions">
      <a class="lp-button lp-button-solid" href="/verify"><i class="fa-solid fa-qrcode" aria-hidden="true"></i>{hero.scan}</a>
      <a class="lp-button lp-button-outline lp-architecture-button" href="#technology">{hero.architecture}<i class="fa-solid fa-arrow-down" aria-hidden="true"></i></a>
    </div>
    <ul class="lp-hero-benefits">
      {hero.benefits.map((benefit) => <li><i class="fa-solid fa-check" aria-hidden="true"></i>{benefit}</li>)}
    </ul>
    <p class="lp-fee-note">{hero.feeNote}</p>
  </div>
  <AuditWidget copy={audit} artwork={artwork} product={product} client:load />
</section>
