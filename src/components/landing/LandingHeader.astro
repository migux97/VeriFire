---
import BrandLogo from '@/components/layout/BrandLogo.astro';
import { ThemeToggle } from '@/components/ui/ThemeToggle';
import { ProfileMenu } from '@/components/warranties/ProfileMenu';
import { getLandingMessages } from '@/i18n/landing';
import { getTechnicalLandingCopy } from '@/i18n/technical-landing';
import LanguageMenu from '@/components/ui/LanguageMenu.astro';
const locale = Astro.currentLocale ?? 'es';
const { nav: shared, profile } = getLandingMessages(locale);
const { nav, account } = getTechnicalLandingCopy(locale);
---

<header class="lp-header lp-technical-header">
  <BrandLogo />
  <nav class="lp-nav" aria-label={shared.sections}>
    <a href="#technology">{nav.technology}</a>
    <a href="#how-it-works">{nav.how}</a>
    <a href="#history">{nav.cases}</a>
    <a href="#docs-api">{nav.docs}</a>
  </nav>
  <div class="lp-header-actions">
    <LanguageMenu locale={locale} label={shared.language} />
    <ThemeToggle client:load label={profile.dark} />
    <a class="lp-button lp-button-solid lp-header-cta" href="/verify"><i class="fa-solid fa-qrcode" aria-hidden="true"></i>{nav.scan}</a>
    {/* Visitors get the account links; a session opened in another tab gets its panel and its profile (SessionGate). */}
    <div class="lp-header-account lp-guest-actions">
      <a class="lp-header-login" href="/login">{account.login}</a>
      <a class="lp-button lp-button-outline lp-header-register" href="/login?modo=registro">{account.register}</a>
    </div>
    <div class="lp-header-account lp-session-actions">
      <a class="lp-button lp-button-outline lp-header-register" href="/app">{shared.dashboard}</a>
      <ProfileMenu client:load labels={profile} />
    </div>
  </div>
</header>
