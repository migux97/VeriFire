---
// Header of the landing page. The search box is the public verification form: it opens /verify with the code.
import BrandLogo from './BrandLogo.astro';
---

<header class="lp-header">
  <BrandLogo />

  <a class="lp-button lp-button-outline lp-header-verify" href="/verify">
    <i class="fa-solid fa-qrcode" aria-hidden="true"></i> Verificar producto
  </a>

  <nav class="lp-nav" aria-label="Secciones">
    <a href="#history">Historial</a>
    <a href="#how-it-works">Cómo funciona</a>
    <a href="#brands">Para marcas</a>
    <a href="#faq">Preguntas</a>
  </nav>

  <form class="lp-search" method="get" action="/verify" role="search">
    <label class="visually-hidden" for="lp-search-token">Código del producto</label>
    <input id="lp-search-token" name="token" type="text" placeholder="Código del producto" autocomplete="off" spellcheck="false" required />
    <button type="submit" aria-label="Verificar el código"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
  </form>

  <a class="lp-login" href="/login">
    <i class="fa-regular fa-user" aria-hidden="true"></i>
    <span>Ingresar</span>
  </a>
</header>
