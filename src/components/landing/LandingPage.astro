---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandLogo from '@/components/layout/BrandLogo.astro';
import LandingHeader from '@/components/landing/LandingHeader.astro';
import LandingHero from '@/components/landing/LandingHero.astro';
import LandingSprite from '@/components/landing/LandingSprite.astro';
import PackageArt from '@/components/landing/PackageArt.astro';
import ProductTrace from '@/components/landing/ProductTrace.astro';
import ProductJourney from '@/components/landing/ProductJourney.astro';
import IntegrationDocs from '@/components/landing/IntegrationDocs.astro';
import AccountAccess from '@/components/landing/AccountAccess.astro';
import { getLandingMessages } from '@/i18n/landing';
import { getLandingContent } from '@/i18n/landing-content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import '@/styles/landing.css';
import '@/styles/landing-tailwind.css';
import '@/styles/landing-technical.css';
import '@/styles/landing-motion.css';

const locale = Astro.currentLocale ?? 'es';
const copy = getLandingMessages(locale);
const { faqs, safeguards } = getLandingContent(locale);
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  bodyClass="landing-page"
  session="landing"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="es" href={new URL(getRelativeLocaleUrl('es'), Astro.url.origin).href} />
    <link rel="alternate" hreflang="en" href={new URL(getRelativeLocaleUrl('en'), Astro.url.origin).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('es'), Astro.url.origin).href} />
  </Fragment>
  <LandingSprite />

  <LandingHeader />

  <main>
    <LandingHero />
    <ProductTrace />
    <ProductJourney />

    <section class="lp-band" id="how-it-works" aria-labelledby="lp-band-title">
      <div class="lp-band-copy">
        <h2 id="lp-band-title">{copy.band.title}</h2>
        <p class="lp-band-lead">{copy.band.lead}</p>
        <dl class="lp-band-list">
          <div>
            <dt><i class="fa-solid fa-eye" aria-hidden="true"></i> {copy.band.publicTitle}</dt>
            <dd>{copy.band.publicText}</dd>
          </div>
          <div>
            <dt><i class="fa-solid fa-key" aria-hidden="true"></i> {copy.band.secretTitle}</dt>
            <dd>{copy.band.secretText}</dd>
          </div>
        </dl>
        <a class="lp-button lp-button-light" href="/verify">
          {copy.band.verify} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="lp-band-art" aria-hidden="true">
        <svg class="lp-guilloche lp-band-guilloche" focusable="false"><use href="#lp-guilloche"></use></svg>
        <PackageArt class="lp-band-package" word={copy.band.original} color="#ffffff" lot="1043" />
        <div class="lp-insert">
          <img class="lp-insert-logo" src="/brand/verifire.png" alt="Verifire" width="103" height="32" />
          <svg viewBox="0 0 10 10" focusable="false"><use href="#lp-qr-secret" width="10" height="10"></use></svg>
          <strong>{copy.band.activation}</strong>
          <span>{copy.band.activationHint}</span>
        </div>
        <span class="lp-tag lp-tag-public">{copy.band.publicQr}</span>
        <span class="lp-tag lp-tag-secret">{copy.band.secretQr}</span>
      </div>
    </section>

    <section class="lp-section" id="brands" aria-labelledby="lp-audiences-title">
      <h2 id="lp-audiences-title" class="lp-section-title">{copy.audiences.title}</h2>
      <div class="lp-audiences">
        <article class="lp-audience lp-audience-brand">
          <div class="lp-audience-copy">
            <h3>{copy.audiences.brands}</h3>
            <p>{copy.audiences.brandsText}</p>
            <ul>
              <li>{copy.audiences.brandBenefits[0]}</li>
              <li>{copy.audiences.brandBenefits[1]}</li>
              <li>{copy.audiences.brandBenefits[2]}</li>
            </ul>
            <a class="lp-button lp-button-solid" href="/create-company">{copy.audiences.createCompany}</a>
          </div>
          <PackageArt class="lp-audience-art" word={copy.audiences.brandLabel} color="#e3261f" lot="0001" />
        </article>

        <article class="lp-audience lp-audience-buyer">
          <div class="lp-audience-copy">
            <h3>{copy.audiences.buyers}</h3>
            <p>{copy.audiences.buyersText}</p>
            <ul>
              <li>{copy.audiences.buyerBenefits[0]}</li>
              <li>{copy.audiences.buyerBenefits[1]}</li>
              <li>{copy.audiences.buyerBenefits[2]}</li>
            </ul>
            <a class="lp-button lp-button-outline" href="/app">{copy.audiences.activate}</a>
          </div>
          <svg class="lp-audience-art lp-phone" viewBox="0 0 170 260" aria-hidden="true" focusable="false">
            <rect x="20" y="8" width="130" height="244" rx="22" fill="#000000"></rect>
            <rect x="30" y="30" width="110" height="200" rx="6" fill="#ffffff"></rect>
            <rect x="68" y="16" width="34" height="6" rx="3" fill="#2e2e2e"></rect>
            <use href="#lp-qr-secret" x="47" y="58" width="76" height="76"></use>
            <path d="M40 48h14M40 48v14M130 48h-14M130 48v14M40 144h14M40 144v-14M130 144h-14M130 144v-14" stroke="#e3261f" stroke-width="3" fill="none"></path>
            <image href="/brand/verifire.png" x="42" y="158" width="86" height="27"></image>
            <rect x="42" y="184" width="62" height="8" fill="#cfcfcf"></rect>
            <circle cx="134" cy="210" r="24" fill="#e3261f"></circle>
            <path d="M123 210l8 8 15-16" stroke="#ffffff" stroke-width="4.5" fill="none" stroke-linecap="square"></path>
          </svg>
        </article>
      </div>
    </section>

    <AccountAccess />

    <section class="lp-section" id="technology" aria-labelledby="lp-safeguards-title">
      <h2 id="lp-safeguards-title" class="lp-section-title">{copy.safeguardsTitle}</h2>
      <div class="lp-arches">
        {
          safeguards.map((item) => (
            <article class="lp-arch">
              <div class="lp-arch-top">
                <svg class="lp-guilloche" aria-hidden="true" focusable="false">
                  <use href="#lp-guilloche" />
                </svg>
                <span class="lp-arch-icon">
                  <i class={item.icon} aria-hidden="true" />
                </span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <IntegrationDocs />

    <section class="lp-section lp-faq" id="faq" aria-labelledby="lp-faq-title">
      <h2 id="lp-faq-title" class="lp-section-title">{copy.common.faq}</h2>
      <div class="lp-faq-list">
        {
          faqs.map((faq) => (
            <details class="lp-question">
              <summary>
                {faq.question}
                <i class="fa-solid fa-plus" aria-hidden="true" />
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="lp-footer">
    <div class="lp-footer-inner">
      <div class="lp-footer-brand">
        <BrandLogo light />
        <p>{copy.footer.description}</p>
      </div>
      <nav class="lp-footer-links" aria-label={copy.footer.access}>
        <h2>{copy.footer.access}</h2>
        <a href="/login">{copy.common.login}</a>
        <a href="/login?modo=registro">{copy.nav.register}</a>
        <a href="/app">{copy.footer.warranties}</a>
        <a href="/batches">{copy.footer.batches}</a>
        <a href="/admin">{copy.common.buy}</a>
      </nav>
      <nav class="lp-footer-links" aria-label={copy.footer.sections}>
        <h2>Verifire</h2>
        <a href="#history">{copy.footer.history}</a>
        <a href="#how-it-works">{copy.nav.how}</a>
        <a href="#brands">{copy.nav.brands}</a>
        <a href="#faq">{copy.common.faq}</a>
      </nav>
      <form class="lp-footer-verify" method="get" action="/verify">
        <label for="lp-footer-token">{copy.footer.verify}</label>
        <p>{copy.footer.hint}</p>
        <div>
          <input id="lp-footer-token" name="token" type="text" placeholder={copy.footer.placeholder} autocomplete="off" spellcheck="false" required />
          <button class="lp-button lp-button-solid" type="submit">{copy.common.verify}</button>
        </div>
      </form>
    </div>
    <p class="lp-footer-legal">© {new Date().getFullYear()} Verifire</p>
  </footer>
</BaseLayout>
