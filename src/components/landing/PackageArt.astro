---
// A product box drawn in flat planes: black carton, colored label and the public QR sticker. Needs LandingSprite on
// the page for the QR.
interface Props {
  word: string[];
  color: string;
  lot: string;
  class?: string;
  // Hero only: one rubber stamp per slide, switched by the slider script.
  statuses?: string[];
}

const { word, color, lot, class: className, statuses = [] } = Astro.props;

// The label is 138 units wide: shorter words print bigger.
const longest = Math.max(...word.map((line) => line.length));
const fontSize = Math.min(46, Math.round(122 / (longest * 0.7)));
const lineHeight = fontSize * 0.92;
const firstBaseline = 254 - ((word.length - 1) * lineHeight) / 2 + fontSize * 0.35;
---

<svg class:list={['lp-package', className]} viewBox="0 0 320 400" role="img" aria-hidden="true" focusable="false">
  <ellipse class="lp-package-shadow" cx="156" cy="372" rx="132" ry="12"></ellipse>
  <polygon points="40,86 214,86 272,46 98,46" fill="#3a3a3a"></polygon>
  <rect x="40" y="86" width="174" height="280" fill="#222222"></rect>
  <polygon points="214,86 272,46 272,326 214,366" fill="#121212"></polygon>
  <rect x="40" y="86" width="174" height="34" fill="#2e2e2e"></rect>
  <polygon points="214,86 272,46 272,80 214,120" fill="#1a1a1a"></polygon>

  <rect x="58" y="178" width="138" height="152" fill={color}></rect>
  <rect x="64" y="184" width="126" height="140" fill="none" stroke="#000000" stroke-width="1.2"></rect>
  <text x="127" y="202" class="lp-package-small" text-anchor="middle">Original verificado</text>
  {
    word.map((line, index) => (
      <text x="127" y={firstBaseline + index * lineHeight} class="lp-package-word" font-size={fontSize} text-anchor="middle">
        {line}
      </text>
    ))
  }
  <text x="127" y="316" class="lp-package-small" text-anchor="middle">Lote {lot}</text>

  <g transform="translate(146 96) rotate(-8)">
    <rect width="70" height="70" fill="#ffffff"></rect>
    <use href="#lp-qr-public" x="7" y="7" width="56" height="56"></use>
  </g>

  {
    statuses.length > 0 && (
      <g transform="translate(62 330) rotate(-14)">
        <circle r="48" fill="#e3261f"></circle>
        <circle r="41" fill="none" stroke="#ffffff" stroke-width="1.5"></circle>
        {statuses.map((status, index) => (
          <text class="lp-package-status" data-slide-status={index} y="5" text-anchor="middle" visibility={index === 0 ? 'visible' : 'hidden'}>
            {status}
          </text>
        ))}
      </g>
    )
  }
</svg>
