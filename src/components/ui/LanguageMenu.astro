---
// The language of the site, picked from a small menu: the current one is the button, the other ones are inside, each
// with its flag. A <details> gives the open/close behaviour and the keyboard for free; the script only closes it on a
// click outside or on Escape, which <details> does not do by itself.
// The landing has a route per language; the pages behind the login have one route each and ask for the language with
// ?lang=, which the locale middleware turns into the cookie the whole site reads.
// The flags are drawn here (SVG): Windows shows flag emojis as two letters.
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  locale: string;
  label: string;
  // 'route': /en/ and /; 'query': this same page with ?lang=.
  mode?: 'route' | 'query';
}

const { locale, label, mode = 'route' } = Astro.props;
const LANGUAGES = [
  { code: 'es', name: 'Español', short: 'ES', flag: 'ar' },
  { code: 'en', name: 'English', short: 'EN', flag: 'us' }
] as const;
const current = LANGUAGES.find((language) => language.code === locale) ?? LANGUAGES[0];

const hrefFor = (code: string) => {
  if (mode === 'route') return getRelativeLocaleUrl(code);
  const url = new URL(Astro.url);
  url.searchParams.set('lang', code);
  return `${url.pathname}${url.search}`;
};

// Stripes of the United States flag, top to bottom (13, red first).
const usStripes = Array.from({ length: 13 }, (_, index) => index).filter((index) => index % 2 === 0);
---

<details class="lp-language-menu">
  <summary aria-label={`${label}: ${current.name}`}>
    <span class="lp-flag" aria-hidden="true">
      {current.flag === 'ar' ? (
        <svg viewBox="0 0 18 12"><rect width="18" height="12" fill="#74acdf" /><rect y="4" width="18" height="4" fill="#fff" /><circle cx="9" cy="6" r="1.35" fill="#f6b40e" /></svg>
      ) : (
        <svg viewBox="0 0 19 13"><rect width="19" height="13" fill="#fff" />{usStripes.map((row) => <rect y={row} width="19" height="1" fill="#b22234" />)}<rect width="7.6" height="7" fill="#3c3b6e" /><g fill="#fff"><circle cx="1.5" cy="1.4" r=".45" /><circle cx="3.8" cy="1.4" r=".45" /><circle cx="6.1" cy="1.4" r=".45" /><circle cx="2.65" cy="3.5" r=".45" /><circle cx="4.95" cy="3.5" r=".45" /><circle cx="1.5" cy="5.6" r=".45" /><circle cx="3.8" cy="5.6" r=".45" /><circle cx="6.1" cy="5.6" r=".45" /></g></svg>
      )}
    </span>
    <span>{current.short}</span>
    <i class="fa-solid fa-chevron-down lp-language-caret" aria-hidden="true"></i>
  </summary>
  <ul>
    {
      LANGUAGES.map((language) => (
        <li>
          <a
            href={hrefFor(language.code)}
            lang={language.code}
            hreflang={language.code}
            aria-current={language.code === current.code ? 'true' : undefined}
          >
            <span class="lp-language-option">
              <span class="lp-flag" aria-hidden="true">
                {language.flag === 'ar' ? (
                  <svg viewBox="0 0 18 12"><rect width="18" height="12" fill="#74acdf" /><rect y="4" width="18" height="4" fill="#fff" /><circle cx="9" cy="6" r="1.35" fill="#f6b40e" /></svg>
                ) : (
                  <svg viewBox="0 0 19 13"><rect width="19" height="13" fill="#fff" />{usStripes.map((row) => <rect y={row} width="19" height="1" fill="#b22234" />)}<rect width="7.6" height="7" fill="#3c3b6e" /><g fill="#fff"><circle cx="1.5" cy="1.4" r=".45" /><circle cx="3.8" cy="1.4" r=".45" /><circle cx="6.1" cy="1.4" r=".45" /><circle cx="2.65" cy="3.5" r=".45" /><circle cx="4.95" cy="3.5" r=".45" /><circle cx="1.5" cy="5.6" r=".45" /><circle cx="3.8" cy="5.6" r=".45" /><circle cx="6.1" cy="5.6" r=".45" /></g></svg>
                )}
              </span>
              <span>{language.name}</span>
            </span>
            {language.code === current.code && <i class="fa-solid fa-check" aria-hidden="true"></i>}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>('.lp-language-menu');
  document.addEventListener('click', (event) => {
    menus.forEach((menu) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus.forEach((menu) => {
      if (!menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  });
  // A panel with views in the hash (#settings, #batches) comes back to the same view in the other language.
  menus.forEach((menu) =>
    menu.querySelectorAll<HTMLAnchorElement>('a[hreflang]').forEach((link) =>
      link.addEventListener('click', () => {
        if (window.location.hash && !link.hash) link.hash = window.location.hash;
      })
    )
  );
</script>
