---
import { CompanyIssuance } from '@/components/company/CompanyIssuance';
import { publicConfig } from '@/lib/server/config';
import { countryOptions } from '@/lib/server/countries';
import { CompanyCatalogSummary } from '@/components/company/CompanyCatalogSummary';
import { BatchList } from '@/components/batches/BatchList';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/company.css';
import { CompanyData } from '@/components/company/CompanyData';
import { CompanyIdentity } from '@/components/company/CompanyIdentity';
import { CompanyOperations } from '@/components/company/CompanyOperations';
import { CompanyRoleSettings } from '@/components/company/CompanyRoleSettings';
import { CompanyTeamManager } from '@/components/company/CompanyTeamManager';
---

<BaseLayout
  title="Verifire | Panel empresa"
  description="Panel operativo para gestionar productos, lotes y verificaciones de Verifire."
  bodyClass="company-page"
  session="protected"
>
  <main class="company-shell">
    <aside class="company-sidebar" aria-label="Navegación de empresa">
      <a class="company-brand" href="/">
        <span class="company-brand-mark">V</span>
        <span>verifire</span>
      </a>

      <CompanyIdentity client:load view="workspace" />

      <nav class="company-nav">
        <a class="is-active" href="#dashboard" data-company-tab="dashboard">
          <i class="fa-solid fa-chart-line"></i>
          <span>Resumen</span>
        </a>

        <div class="company-catalog-menu">
          <div class="company-catalog-parent" data-company-tab="catalog">
            <a href="#catalog" data-catalog-home>
              <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i>
              <span>Productos y lotes</span>
            </a>
            <button
              type="button"
              data-catalog-toggle
              aria-expanded="false"
              aria-controls="company-catalog-submenu"
              aria-label="Desplegar opciones de Productos y lotes"
            >
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
          </div>
          <div class="company-sidebar-subnav" id="company-catalog-submenu" hidden>
            <a href="#batches" data-catalog-tab="batches">
              Mis lotes
            </a>
            <a href="#products" data-catalog-tab="products">
              Mis productos
            </a>
            <a href="#generate" data-catalog-tab="generate">
              Generar tokens
            </a>
          </div>
        </div>

        <a href="#activity" data-company-tab="activity">
          <i class="fa-solid fa-qrcode"></i>
          <span>Verificaciones</span>
        </a>
        <a href="#team" data-company-tab="team">
          <i class="fa-solid fa-users"></i>
          <span>Equipo</span>
        </a>
      </nav>

      <div class="company-sidebar-bottom">
        <a href="#settings" data-company-tab="settings">
          <i class="fa-solid fa-gear"></i>
          <span>Configuración</span>
        </a>
        <a href="/">
          <i class="fa-solid fa-arrow-left"></i>
          <span>Volver al sitio</span>
        </a>
      </div>
    </aside>

    <section class="company-content">
      <div data-company-view="dashboard">
        <header class="company-topbar">
          <div>
            <span class="company-eyebrow">Panel empresa</span>
            <h1 tabindex="-1">Resumen operativo</h1>
          </div>
          <div class="company-top-actions">
            <button class="company-icon-button" type="button" aria-label="Notificaciones">
              <i class="fa-regular fa-bell"></i>
              <span></span>
            </button>
            <CompanyIdentity client:load view="profile" />
          </div>
        </header>

        <p class="company-view-description">Indicadores de las compras y lotes disponibles en tu cuenta.</p>
        <CompanyData client:load view="dashboard" />
      </div>

      <div data-company-view="catalog" hidden>
        <header class="company-topbar">
          <div>
            <span class="company-eyebrow">Inventario y producción</span>
            <h1 tabindex="-1">Productos y lotes</h1>
          </div>
        </header>
        <p class="company-view-description">Administrá tus productos, emití tokens y consultá los pagos y etiquetas de cada lote.</p>
        <section data-catalog-view="catalog">
          <CompanyCatalogSummary client:load />
          <CompanyOperations client:load />
        </section>
        <section data-catalog-view="batches" hidden>
          <div class="company-catalog-heading">
            <h2>Mis lotes</h2>
            <a class="company-create-link" href="#generate">
              <i class="fa-solid fa-plus" aria-hidden="true"></i> Generar tokens
            </a>
          </div>
          <BatchList client:load />
        </section>
        <section data-catalog-view="products" hidden>
          <CompanyData client:load view="products" />
        </section>
        <section data-catalog-view="generate" hidden>
          <CompanyIssuance client:load countries={countryOptions} pricePerToken={publicConfig.pricePerToken} />
        </section>
      </div>
      <div data-company-view="activity" hidden>
        <header class="company-topbar">
          <div>
            <span class="company-eyebrow">Trazabilidad</span>
            <h1 tabindex="-1">Verificaciones</h1>
          </div>
        </header>
        <p class="company-view-description">
          Consultá el estado de activación de los productos y abrí su verificación pública. No hay estadísticas de escaneos disponibles.
        </p>
        <CompanyData client:load view="activity" />
      </div>
      <div data-company-view="team" hidden>
        <header class="company-topbar">
          <div>
            <span class="company-eyebrow">Accesos</span>
            <h1 tabindex="-1">Equipo</h1>
          </div>
        </header>
        <p class="company-view-description">Administrá los integrantes y sus permisos.</p>
        <article class="company-panel company-section-panel">
          <CompanyTeamManager client:load />
        </article>
      </div>
      <div data-company-view="settings" hidden>
        <header class="company-topbar company-settings-topbar">
          <div>
            <span class="company-eyebrow">Administración</span>
            <h1 tabindex="-1">Configuración</h1>
          </div>
          <a class="company-action" href="#dashboard" data-company-tab="dashboard">
            <i class="fa-solid fa-arrow-left"></i> Volver al resumen
          </a>
        </header>
        <CompanyRoleSettings client:load />
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { guardSession } from '@/lib/client/session';

  guardSession();

  const views = [...document.querySelectorAll<HTMLElement>('[data-company-view]')];
  const tabs = [...document.querySelectorAll<HTMLElement>('[data-company-tab]')];
  const catalogToggle = document.querySelector<HTMLButtonElement>('[data-catalog-toggle]');
  const catalogSubmenu = document.querySelector<HTMLElement>('#company-catalog-submenu');
  const setCatalogExpanded = (expanded: boolean) => {
    if (catalogSubmenu) catalogSubmenu.hidden = !expanded;
    catalogToggle?.setAttribute('aria-expanded', String(expanded));
    catalogToggle?.setAttribute('aria-label', `${expanded ? 'Cerrar' : 'Desplegar'} opciones de Productos y lotes`);
  };
  catalogToggle?.addEventListener('click', () => setCatalogExpanded(catalogToggle.getAttribute('aria-expanded') !== 'true'));
  document.querySelector('[data-catalog-home]')?.addEventListener('click', () => setCatalogExpanded(true));
  const updateCompanyView = () => {
    const hash = window.location.hash.slice(1);
    const requested = hash === 'operations' ? 'catalog' : hash;
    const catalogViews = [...document.querySelectorAll<HTMLElement>('[data-catalog-view]')];
    const catalogTabs = [...document.querySelectorAll<HTMLElement>('[data-catalog-tab]')];
    const catalog = ['catalog', 'batches', 'products', 'generate'].includes(requested);
    const subview = requested;
    setCatalogExpanded(catalog);
    const catalogHome = document.querySelector('[data-catalog-home]');
    if (requested === 'catalog') catalogHome?.setAttribute('aria-current', 'page');
    else catalogHome?.removeAttribute('aria-current');
    const view = catalog ? 'catalog' : views.some((item) => item.dataset.companyView === requested) ? requested : 'dashboard';
    catalogViews.forEach((item) => {
      item.hidden = item.dataset.catalogView !== subview;
    });
    catalogTabs.forEach((tab) => {
      const selected = tab.dataset.catalogTab === subview;
      tab.classList.toggle('is-active', selected);
      if (selected) tab.setAttribute('aria-current', 'page');
      else tab.removeAttribute('aria-current');
    });
    views.forEach((item) => {
      item.hidden = item.dataset.companyView !== view;
    });
    tabs.forEach((tab) => {
      const selected = tab.dataset.companyTab === view;
      tab.classList.toggle('is-active', selected);
      if (selected && tab.tagName === 'A') tab.setAttribute('aria-current', 'page');
      else tab.removeAttribute('aria-current');
    });
    document.title = `Verifire | ${views.find((item) => !item.hidden)?.querySelector('h1')?.textContent ?? 'Panel empresa'}`;
  };
  window.addEventListener('hashchange', () => {
    updateCompanyView();
    views
      .find((item) => !item.hidden)
      ?.querySelector<HTMLElement>('h1')
      ?.focus({ preventScroll: true });
    window.scrollTo({ top: 0 });
  });
  updateCompanyView();
</script>

<style>
  .company-page {
    background: var(--vf-mist);
  }
  .company-shell {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    min-height: 100vh;
    color: var(--vf-text);
  }
  .company-sidebar {
    display: flex;
    flex-direction: column;
    padding: 28px 18px 22px;
    border-right: 1px solid var(--vf-line);
    background: var(--vf-paper);
  }
  .company-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--vf-ink);
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: -0.06em;
  }
  .company-brand-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    background: var(--vf-red);
    color: var(--vf-on-red);
    font-size: 1rem;
    letter-spacing: 0;
  }
  .company-workspace {
    display: grid;
    gap: 3px;
    margin: 48px 8px 28px;
    padding: 14px 12px;
    border: 1px solid var(--vf-line);
    border-radius: 4px;
    background: var(--vf-mist);
  }
  .company-workspace-label,
  .company-workspace-meta,
  .company-eyebrow {
    color: var(--vf-muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .company-workspace strong {
    color: var(--vf-ink);
    font-size: 0.88rem;
  }
  .company-workspace-meta {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .company-nav,
  .company-sidebar-bottom {
    display: grid;
    gap: 4px;
  }
  .company-nav a,
  .company-sidebar-bottom a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 42px;
    padding: 0 12px;
    border-radius: 3px;
    color: var(--vf-muted);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .company-nav a:hover,
  .company-sidebar-bottom a:hover {
    background: var(--vf-mist);
    color: var(--vf-ink);
  }
  .company-nav a.is-active {
    background: var(--vf-red);
    color: var(--vf-on-red);
  }
  .company-sidebar-bottom a.is-active {
    background: var(--vf-red);
    color: var(--vf-on-red);
  }
  .company-nav a i,
  .company-sidebar-bottom a i {
    width: 16px;
    text-align: center;
  }
  .company-nav b {
    margin-left: auto;
    font-size: 0.68rem;
    font-weight: 800;
  }
  .company-nav .is-alert {
    color: var(--vf-red);
  }
  .company-nav .is-active .is-alert {
    color: var(--vf-on-red);
  }
  .company-sidebar-bottom {
    gap: 2px;
    margin-top: auto;
    border-top: 1px solid var(--vf-line);
    padding-top: 18px;
  }
  .company-content {
    min-width: 0;
    padding: 34px clamp(24px, 4vw, 58px) 52px;
  }
  .company-topbar,
  .company-toolbar,
  .company-panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }
  .company-topbar h1 {
    margin-top: 4px;
    font-size: clamp(1.75rem, 3vw, 2.45rem);
  }
  .company-top-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .company-icon-button,
  .panel-icon-action {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--vf-line-strong);
    border-radius: 4px;
    background: var(--vf-paper);
    color: var(--vf-ink);
    cursor: pointer;
  }
  .company-icon-button span {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--vf-red);
  }
  .company-profile {
    display: flex;
    align-items: center;
    gap: 9px;
    border: 0;
    background: transparent;
    color: var(--vf-ink);
    text-align: left;
    cursor: pointer;
  }
  .company-profile strong,
  .company-profile small,
  .team-list strong,
  .team-list small {
    display: block;
  }
  .company-profile strong {
    font-size: 0.8rem;
  }
  .company-profile small {
    color: var(--vf-muted);
    font-size: 0.7rem;
  }
  .company-profile > i {
    margin-left: 5px;
    color: var(--vf-muted);
    font-size: 0.7rem;
  }
  .company-avatar,
  .team-avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--vf-red);
    color: var(--vf-on-red);
    font-size: 0.65rem;
    font-weight: 900;
  }
  .company-toolbar {
    margin-top: 34px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--vf-line);
    color: var(--vf-muted);
    font-size: 0.78rem;
  }
  .company-toolbar span {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .company-action {
    min-height: 36px;
    padding: 0 13px;
    border: 1px solid var(--vf-line-strong);
    border-radius: 3px;
    background: var(--vf-paper);
    color: var(--vf-ink);
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
  }
  .company-action i {
    margin-right: 6px;
    color: var(--vf-red);
  }
  .company-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 20px;
  }
  .company-metric {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px;
    border: 1px solid var(--vf-line);
    border-radius: 4px;
    background: var(--vf-paper);
  }
  .metric-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 3px;
    font-size: 0.84rem;
  }
  .metric-blue {
    background: #e8eefb;
    color: #1f4fb8;
  }
  .metric-green {
    background: #e6f4eb;
    color: #0f6b35;
  }
  .metric-amber {
    background: #fff2d7;
    color: #a56b00;
  }
  .metric-red {
    background: var(--vf-blush);
    color: var(--vf-red);
  }
  .company-metric small,
  .company-metric strong,
  .company-metric em {
    display: block;
  }
  .company-metric small {
    color: var(--vf-muted);
    font-size: 0.7rem;
  }
  .company-metric strong {
    margin-top: 4px;
    color: var(--vf-ink);
    font-size: 1.35rem;
    line-height: 1;
  }
  .company-metric em {
    margin-top: 7px;
    color: var(--vf-muted);
    font-size: 0.68rem;
    font-style: normal;
  }
  .metric-positive {
    color: var(--vf-success) !important;
  }
  .metric-positive span {
    color: var(--vf-muted);
  }
  .products-operations {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--vf-line);
  }
  .operations-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--vf-success);
    font-size: 0.66rem;
    font-weight: 800;
  }
  .operations-status i {
    font-size: 0.42rem;
  }
  .operations-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: 16px;
  }
  .operation-action {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 11px;
    border: 1px solid var(--vf-line);
    border-radius: 3px;
    background: var(--vf-paper);
    color: var(--vf-ink);
    text-align: left;
    cursor: pointer;
  }
  .operation-action:hover {
    border-color: var(--vf-red);
  }
  .operation-action > i:first-child {
    flex: none;
    color: var(--vf-red);
    font-size: 0.82rem;
  }
  .operation-action > i:last-child {
    margin-left: auto;
    color: var(--vf-muted);
    font-size: 0.6rem;
  }
  .operation-action span {
    min-width: 0;
  }
  .operation-action strong,
  .operation-action small {
    display: block;
  }
  .operation-action strong {
    font-size: 0.68rem;
  }
  .operation-action small {
    margin-top: 3px;
    color: var(--vf-muted);
    font-size: 0.59rem;
  }
  .operation-action-primary {
    border-color: var(--vf-red);
    background: var(--vf-red);
    color: var(--vf-on-red);
  }
  .operation-action-primary > i:first-child,
  .operation-action-primary > i:last-child,
  .operation-action-primary small {
    color: inherit;
  }
  .operations-form {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    align-items: end;
    gap: 9px;
    margin-top: 12px;
    padding: 12px;
    border: 1px solid var(--vf-line);
    border-radius: 3px;
    background: var(--vf-mist);
  }
  .operations-form-heading {
    display: flex;
    grid-column: 1 / -1;
    justify-content: space-between;
    align-items: center;
    color: var(--vf-ink);
    font-size: 0.7rem;
  }
  .operations-form-heading button {
    border: 0;
    background: transparent;
    color: var(--vf-muted);
    cursor: pointer;
  }
  .operations-form label {
    display: grid;
    gap: 5px;
    color: var(--vf-muted);
    font-size: 0.62rem;
    font-weight: 800;
  }
  .operations-form input {
    min-height: 31px;
    width: 100%;
    padding: 0 7px;
    border: 1px solid var(--vf-line-strong);
    border-radius: 3px;
    background: var(--vf-paper);
    color: var(--vf-ink);
    font-size: 0.66rem;
  }
  .operations-form-actions {
    display: flex;
    grid-column: 1 / -1;
    justify-content: flex-end;
    gap: 6px;
  }
  .operations-submit,
  .operations-cancel {
    min-height: 31px;
    padding: 0 9px;
    border: 1px solid var(--vf-line-strong);
    border-radius: 3px;
    background: var(--vf-paper);
    color: var(--vf-ink);
    font-size: 0.63rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
  }
  .operations-submit {
    border-color: var(--vf-red);
    background: var(--vf-red);
    color: var(--vf-on-red);
  }
  .operations-submit i {
    margin-right: 5px;
  }
  .operations-schedule-heading {
    display: flex;
    justify-content: space-between;
    margin-top: 17px;
    color: var(--vf-ink);
    font-size: 0.7rem;
    font-weight: 800;
  }
  .operations-schedule-heading small {
    color: var(--vf-muted);
    font-size: 0.6rem;
    font-weight: 500;
  }
  .operations-schedule {
    display: grid;
    gap: 6px;
    margin-top: 8px;
  }
  .operations-item {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    border-top: 1px solid var(--vf-line);
  }
  .operations-item-icon {
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    border-radius: 3px;
    background: #e8eefb;
    color: #1f4fb8;
    font-size: 0.64rem;
  }
  .operations-item-icon.is-payment {
    background: #fff2d7;
    color: #a56b00;
  }
  .operations-item strong,
  .operations-item small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .operations-item strong {
    color: var(--vf-ink);
    font-size: 0.65rem;
  }
  .operations-item small,
  .operations-item time {
    color: var(--vf-muted);
    font-size: 0.58rem;
  }
  .operations-item-status {
    display: none;
  }
  .operations-notice {
    margin: 8px 0 0;
    color: var(--vf-success);
    font-size: 0.62rem;
  }
  .company-grid-main,
  .company-grid-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.85fr);
    gap: 14px;
    margin-top: 14px;
  }
  .company-grid-bottom {
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.85fr);
  }
  .company-panel {
    min-width: 0;
    padding: 22px;
    border: 1px solid var(--vf-line);
    border-radius: 4px;
    background: var(--vf-paper);
  }
  .company-panel h2 {
    margin-top: 4px;
    font-size: 1.12rem;
  }
  .company-panel-heading > a,
  .panel-link {
    color: var(--vf-red);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .company-panel-heading > a i,
  .panel-link i {
    margin-left: 5px;
    font-size: 0.65rem;
  }
  .company-table-wrap {
    margin-top: 18px;
    overflow-x: auto;
  }
  .company-table {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    font-size: 0.75rem;
  }
  .company-table th {
    padding: 0 12px 11px;
    border-bottom: 1px solid var(--vf-line);
    color: var(--vf-muted);
    font-size: 0.65rem;
    font-weight: 800;
    text-align: left;
    text-transform: uppercase;
  }
  .company-table td {
    padding: 12px;
