---
// Public page behind the QR on the outside of the box: anyone (for example store staff) can check a product here
// without logging in. It only shows public data and does not link to the rest of the app.
import LocalDates from '@/components/layout/LocalDates.astro';
import StandaloneHeader from '@/components/layout/StandaloneHeader.astro';
import { ProductDetails } from '@/components/verification/ProductDetails';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { findProduct, publicProductView } from '@/lib/server/products';

const requestedToken = Astro.url.searchParams.get('token') ?? '';
const found = requestedToken.trim() ? findProduct(requestedToken) : undefined;
const product = found ? publicProductView(found) : null;

let title = 'Verificá tu producto';
let message = 'Escaneá el QR de la caja o ingresá el código público del producto.';
if (product) {
  title = product.claimed ? 'Producto original · garantía activa' : 'Producto original · sellado';
  message = product.claimed
    ? 'La garantía de este producto ya fue activada por su comprador.'
    : 'La caja está sellada en fábrica y la garantía todavía no fue activada.';
} else if (requestedToken.trim()) {
  title = 'No se pudo verificar';
  message = 'El token de producto no existe.';
  Astro.response.status = 404;
}
---

<BaseLayout
  title="Verifire | Verificación de producto"
  description="Verificación pública de autenticidad y estado de un producto Verifire."
  bodyClass="verify-page"
>
  <main class="verify-shell">
    <StandaloneHeader>
      <span class="network-status"><span></span>Verificación pública</span>
    </StandaloneHeader>

    <section class="verify-card" aria-labelledby="verify-title">
      <div class="verify-intro">
        <div class="verify-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
        <div>
          <span class="eyebrow">QR público del producto</span>
          <h1 id="verify-title">{title}</h1>
        </div>
      </div>
      <p class="verify-message">{message}</p>
      {product && <ProductDetails product={product} />}

      <form class="verification-form" method="get" action="/verify">
        <label for="verification-code">Código público del producto</label>
        <div class="verification-input-row">
          <input id="verification-code" name="token" type="text" placeholder="Ej. VF-001" autocomplete="off" spellcheck="false" value={requestedToken} required />
          <button class="button button-primary" type="submit"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Verificar</button>
        </div>
        <span class="verification-hint">No hace falta iniciar sesión: esta página solo muestra información pública del producto.</span>
      </form>
    </section>
  </main>

  {product?.claimed && <LocalDates />}
</BaseLayout>
