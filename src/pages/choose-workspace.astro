---
import { WorkspaceChooser } from '@/components/company/WorkspaceChooser';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/auth.css';
---

<BaseLayout
  title="Verifire | Elegir espacio"
  description="Elegí entre tu cuenta personal y el espacio empresarial al que fuiste invitado."
  bodyClass="workspace-page"
  session="protected"
>
  <script>
    import { guardSession } from '@/lib/client/session';

    // Without this the page only hides itself behind SessionGate and never leaves for the login.
    guardSession();
  </script>
  <main class="workspace-shell">
    <a class="workspace-brand" href="/">
      <span>V</span> verifire
    </a>
    <WorkspaceChooser client:load />
  </main>
</BaseLayout>

<style>
  .workspace-page {
    background: var(--vf-mist);
  }
  .workspace-shell {
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding: 32px 20px;
  }
  .workspace-brand {
    position: fixed;
    top: 28px;
    left: 32px;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--vf-ink);
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.06em;
  }
  .workspace-brand span {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    background: var(--vf-red);
    color: var(--vf-on-red);
    letter-spacing: 0;
  }
  :global(.workspace-chooser) {
    width: min(100%, 520px);
    padding: 42px;
    border: 1px solid var(--vf-line);
    border-radius: 6px;
    background: var(--vf-paper);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
  }
  :global(.workspace-chooser-mark) {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 24px;
    border-radius: 4px;
    background: var(--vf-blush);
    color: var(--vf-red);
    font-size: 1.15rem;
  }
  :global(.workspace-chooser h1) {
    margin-top: 8px;
    font-size: clamp(1.75rem, 4vw, 2.35rem);
  }
  :global(.workspace-chooser-lead) {
    margin-top: 12px;
    color: var(--vf-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  :global(.workspace-chooser-lead strong) {
    color: var(--vf-ink);
  }
  :global(.workspace-invitation) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 26px;
    padding: 18px;
    border-left: 3px solid var(--vf-red);
    background: var(--vf-mist);
  }
  :global(.workspace-invitation div) {
    display: grid;
    gap: 3px;
  }
  .workspace-invitation small {
    color: var(--vf-muted);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .workspace-invitation strong {
    color: var(--vf-ink);
    font-size: 0.9rem;
  }
  .workspace-invitation-status {
    grid-column: 1 / -1;
    color: var(--vf-success);
    font-size: 0.72rem;
    font-weight: 800;
  }
  .workspace-invitation-status i {
    margin-right: 5px;
  }
  :global(.workspace-options) {
    display: grid;
    gap: 10px;
    margin-top: 26px;
  }
  :global(.workspace-option) {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 13px;
    border: 1px solid var(--vf-line-strong);
    border-radius: 4px;
    background: var(--vf-paper);
    color: var(--vf-ink);
    text-align: left;
    cursor: pointer;
  }
  .workspace-option:hover:not(:disabled) {
    border-color: var(--vf-red);
  }
  .workspace-option:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
  .workspace-option-company {
    border-color: var(--vf-red);
  }
  .workspace-option-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: var(--vf-blush);
    color: var(--vf-red);
  }
  .workspace-option span:nth-child(2) {
    display: grid;
    gap: 3px;
  }
  .workspace-option strong {
    font-size: 0.82rem;
  }
  .workspace-option small {
    color: var(--vf-muted);
    font-size: 0.7rem;
  }
  .workspace-option > i {
    color: var(--vf-red);
    font-size: 0.75rem;
  }
  @media (max-width: 600px) {
    .workspace-brand {
      top: 20px;
      left: 20px;
    }
    .workspace-shell {
      padding: 78px 16px 24px;
    }
    .workspace-chooser {
      padding: 28px 22px !important;
    }
    .workspace-invitation {
      grid-template-columns: 1fr !important;
    }
    .workspace-invitation-status {
      grid-column: auto !important;
    }
  }
</style>
