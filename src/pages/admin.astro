---
import StandaloneHeader from '@/components/layout/StandaloneHeader.astro';
import { PurchaseForm } from '@/components/purchase/PurchaseForm';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { countryOptions } from '@/lib/server/countries';

// The list of countries is fixed, so the page is built once.
export const prerender = true;
---

<BaseLayout
  title="Verifire | Comprar tokens"
  description="Compra de tokens y etiquetas QR para empresas en Verifire."
  bodyClass="verify-page"
  session="protected"
>
  <main class="verify-shell admin-shell">
    <StandaloneHeader brandHref="/app">
      <a class="network-status" href="/lotes"><span></span>Ver mis lotes</a>
    </StandaloneHeader>

    <section class="verify-card" aria-labelledby="new-batch-title">
      <span class="eyebrow">Nuevo lote</span>
      <h1 id="new-batch-title">Comprá tokens con Cosmos Pay</h1>
      <p class="verify-message">Cada token tiene un precio fijo en XLM. El lote se genera cuando Cosmos Pay confirma el pago, y queda guardado en Mis lotes con sus etiquetas.</p>
      <PurchaseForm client:load countries={countryOptions} />
    </section>
  </main>

  <script>
    import { guardSession } from '@/lib/client/session';

    guardSession();
  </script>
</BaseLayout>
