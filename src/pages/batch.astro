---
// Public page behind the QR of a whole lot: read-only summary, no session needed.
import StandaloneHeader from '@/components/layout/StandaloneHeader.astro';
import { IssuerBadge } from '@/components/ui/IssuerBadge';
import { DetailRows } from '@/components/verification/DetailRows';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getVerifyMessages } from '@/i18n/verify';
import { publicBaseUrl } from '@/lib/server/config';
import { pageLocale } from '@/lib/server/page-locale';
import { findBatch, publicBatchView } from '@/lib/server/purchases';

const locale = pageLocale(Astro);
const copy = getVerifyMessages(locale);

const batchId = Astro.url.searchParams.get('batch');
const found = batchId ? findBatch(batchId) : undefined;
const batch = found ? publicBatchView(found, publicBaseUrl(Astro.url)) : null;
const claimed = batch?.tokens.filter((token) => token.status === 'CLAIMED_IN_WARRANTY').length ?? 0;

// "Original" only for a verified issuer (see verify.astro).
const trust = batch ? (batch.issuer?.verified ? 'verified' : batch.issuer ? 'unverified' : 'unknown') : null;

let title = copy.batch.unavailableTitle;
let message = copy.batch.lead;
if (batch) {
  title = trust === 'verified' ? copy.batch.title : copy.batch.registeredTitle;
  message = copy.batch.summary.replace('{claimed}', String(claimed)).replace('{quantity}', String(batch.quantity));
} else if (batchId) {
  message = copy.batch.notFound;
  Astro.response.status = 404;
}
---

<BaseLayout title={copy.meta.batchTitle} description={copy.meta.batchDescription} bodyClass="verify-page">
  <main class="verify-shell">
    <StandaloneHeader>
      <span class="network-status"><span></span>{copy.header.network}</span>
    </StandaloneHeader>
    <section class="verify-card" aria-labelledby="batch-title">
      <span class="eyebrow">{copy.header.batchEyebrow}</span>
      <h1 id="batch-title">{title}</h1>
      <p class="verify-message">{message}</p>
      {trust && (
        <p class={`verify-trust is-${trust}`} role="note">
          <i class={`fa-solid ${trust === 'verified' ? 'fa-circle-check' : 'fa-triangle-exclamation'}`} aria-hidden="true"></i>
          {' '}
          {copy.product.trust[trust]}
          {trust === 'verified' && batch?.issuer?.domain && ` ${copy.product.trust.verifiedSite.replace('{domain}', batch.issuer.domain)}`}
        </p>
      )}
      {batch?.photoUrl && <img class="verify-photo" src={batch.photoUrl} alt={copy.photoAlt.replace('{model}', batch.model)} loading="lazy" decoding="async" />}
      {batch?.issuer && <IssuerBadge issuer={batch.issuer} labels={{ issuedBy: copy.issuer.issuedBy, write: copy.issuer.write, call: copy.issuer.call, verified: copy.issuer.verified, unverified: copy.issuer.unverified }} />}
      {
        batch && (
          <DetailRows
            tone="available"
            rows={[
              [copy.batch.rows.model, batch.model],
              [copy.batch.rows.lot, batch.lot],
              [copy.batch.rows.destination, batch.destination],
              [copy.batch.rows.products, batch.quantity],
              ...batch.tokens.map((token): [string, string] => [token.token, token.status === 'SEALED' ? copy.batch.status.sealed : copy.batch.status.claimed])
            ]}
          />
        )
      }
    </section>
  </main>
</BaseLayout>
