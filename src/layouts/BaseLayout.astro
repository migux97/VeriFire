---
import '@fortawesome/fontawesome-free/css/all.min.css';
import '@/styles/brand.css';
import '@/styles/global.css';
import { Font } from 'astro:assets';
import SessionGate from '@/components/layout/SessionGate.astro';
import { THEME_KEY } from '@/lib/client/theme';
import { pageLocale } from '@/lib/server/page-locale';

interface Props {
  title: string;
  description: string;
  bodyClass: string;
  session?: 'public' | 'protected' | 'guest' | 'landing';
}

const { title, description, bodyClass, session = 'public' } = Astro.props;
---

<!doctype html>
<html lang={pageLocale(Astro)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline define:vars={{ THEME_KEY }}>
      try {
        if (localStorage.getItem(THEME_KEY) === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {
        // Without storage the page stays light.
      }
    </script>
    {session !== 'public' && <SessionGate mode={session} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-urbanist" preload={[{ weight: 500 }, { weight: 800 }]} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
