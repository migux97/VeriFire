---
import '@fortawesome/fontawesome-free/css/all.min.css';
import '@/styles/global.css';
import { Font } from 'astro:assets';
import SessionGate from '@/components/layout/SessionGate.astro';

interface Props {
  title: string;
  description: string;
  bodyClass: string;
  session?: 'public' | 'protected' | 'guest';
}

const { title, description, bodyClass, session = 'public' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {session !== 'public' && <SessionGate mode={session} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }, { weight: 600 }]} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
